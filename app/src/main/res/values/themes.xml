<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MediaViewer" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.MediaViewer.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF101418</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.MediaViewer</item>
    </style>
</resources>
