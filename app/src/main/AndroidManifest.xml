<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 11+: "All files access" (README §1, Storage access). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 8–10: classic storage permissions. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"
        tools:ignore="ScopedStorage" />

    <!-- Background playback of books and lectures (todo §3.3). Media notifications are exempt from
         the Android 13 notification permission; it is declared, never requested. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ package visibility: find an external video player for long videos (README §3.11). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <!-- One APK for phone, tablet, Chromebook and TV. -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <!-- Cameras and phones over USB OTG (todo §9). -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />

    <application
        android:name=".MediaViewerApp"
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.MediaViewer.Splash">

        <!-- Samsung DeX: keep the app running when the phone switches to or from DeX (README §3.9). -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
        <meta-data android:name="com.samsung.android.multidisplay.keep_process_alive" android:value="true" />
        <!-- Samsung DeX: 0 × 0 launches full screen instead of in a window. -->
        <meta-data android:name="com.samsung.android.dex.launchwidth" android:value="0" />
        <meta-data android:name="com.samsung.android.dex.launchheight" android:value="0" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode"
            android:exported="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Samsung DeX: in the full-screen slideshow, the taskbar appears only after 2 s at the screen edge. -->
            <meta-data android:name="com.samsung.android.dex.transient_bar_delay" android:value="2000" />
            <!-- Chromebooks and Android desktop windowing: the first window fills the screen. -->
            <layout
                android:defaultWidth="100%"
                android:defaultHeight="100%"
                android:gravity="center"
                android:minWidth="400dp"
                android:minHeight="320dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Crash screen (README §3.5): its own process, so it opens even when the app can't start. -->
        <activity
            android:name=".ui.CrashActivity"
            android:exported="false"
            android:process=":crash"
            android:theme="@style/Theme.MediaViewer" />

        <!-- Book / lecture playback (todo §3.3). Exported so system UI, Bluetooth, watches and cars can
             control it, as every media session service is. -->
        <service
            android:name=".playback.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
        <!-- Headset / Bluetooth Play after the app was killed resumes the last book. -->
        <receiver
            android:name="androidx.media3.session.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
